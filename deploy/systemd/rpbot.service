[Unit]
Description=Roleplayer Discord Bot (.NET 8)
Documentation=https://github.com/elmer-grey/RoleplayerDiscordBot
After=network-online.target lavalink.service
Wants=network-online.target
# Если Lavalink упал — бот сам перезапустит его (Music.AutoStart=true).
# lavalink.service нужен только если хочется держать Lavalink как отдельный процесс.
# Если используешь встроенный запуск Lavalink из бота — убери After=/Wants= выше.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=rpbot
Group=rpbot
WorkingDirectory=/opt/rpbot/RoleplayerDiscordBot/RPBot
ExecStart=/usr/bin/dotnet /opt/rpbot/RoleplayerDiscordBot/RPBot/RPBot.dll
# Headless-режим: на VPS нет /dev/tty, Terminal.Gui не запустится.
# Логи и управление — через journalctl.
Environment=RPBOT_NO_UI=1
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_NOLOGO=1
# ⚠️ Discord-токен НЕ кладите в этот файл — он попадёт в git!
# Задайте через `systemctl edit rpbot.service`:
#   [Service]
#   Environment=DISCORD_BOT_TOKEN=ваш.токен.сюда
#   Environment=RPBOT_FULL_START=1   # только для первого деплоя / принудительной перерегистрации
# По умолчанию бот читает токен из config.json (BotToken), env имеет приоритет.
# Переменная для override корня данных. По умолчанию бот использует
# ~/.local/share/rpbot (XDG_DATA_HOME). Лучше задать явно — путь стабильнее.
Environment=RPBOT_DATA_DIR=/var/lib/rpbot

# Автоперезапуск при любом падении (включая kill -9 с последующим OOM-возвратом).
Restart=always
RestartSec=5
# Корректный shutdown: Discord.Net гасит WebSocket, WebDashboard закрывается.
# 60 секунд хватает с запасом; после этого systemd пошлёт SIGKILL.
TimeoutStopSec=60
# Посылаем SIGTERM (а не SIGKILL сразу) на остановке — даём процессу шанс отработать
# CancellationToken'ы в MusicService, GameSession, EventOpsLifecycleService.
KillSignal=SIGTERM

# Лимиты ресурсов. 1 vCPU / 2 GB VPS — для бота хватает с запасом.
# MemoryMax — выше systemd прибьёт через OOM-killer.
# CPUQuota=80% от 1 ядра = 0.8 CPU. Lavalink и yt-cipher получают остаток.
MemoryMax=1500M
CPUQuota=80%
# File descriptor limit для HttpListener и одновременных WebSocket-соединений Discord.
LimitNOFILE=65536

# Hardening — минимально необходимые capabilities, без root.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/rpbot /opt/rpbot/RoleplayerDiscordBot /home/rpbot
# /home/rpbot нужен .NET CLI для first-use (создаёт .dotnet/, .config/, и т.д.):
# при ProtectHome=read-only без этого пути бот падает на первой попытке
# что-то записать в $HOME. Альтернатива — создать /home/rpbot/{.dotnet,.aspnet,
# .local,.config} заранее (см. SETUP-LINUX.md, шаг 2).

# stdout/stderr уходят в journald — основной способ просмотра логов на VPS.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rpbot

[Install]
WantedBy=multi-user.target