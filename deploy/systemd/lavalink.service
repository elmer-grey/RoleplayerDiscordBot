[Unit]
Description=Lavalink music server (Java 21) for Roleplayer Discord Bot
Documentation=https://github.com/lavalink-devs/Lavalink
# Можно запускать независимо от бота — RPBot сам подключится к 127.0.0.1:2333.
# Если бот стартует Lavalink сам через Music.AutoStart=true — этот unit избыточен,
# но удобен для отладки (видно `systemctl status lavalink`).
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=rpbot
Group=rpbot
WorkingDirectory=/opt/rpbot/RoleplayerDiscordBot/Lavalink
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/rpbot/RoleplayerDiscordBot/Lavalink/Lavalink.jar
# Лимиты JVM: 256-512 МБ хватает для 5+ одновременных плееров на 1 ядре.
# Поднять, если много параллельных треков или падают long-running сеты.

# Lavalink.jar читает application.yml из текущей директории (WorkingDirectory).
# OAuth refreshToken лежит в этом же файле — никаких секретов в env не надо.

Restart=always
RestartSec=5

# Лимиты — Lavalink ест больше всех: heap JVM + native + стек.
MemoryMax=800M
CPUQuota=40%
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/rpbot/RoleplayerDiscordBot/Lavalink/logs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lavalink

[Install]
WantedBy=multi-user.target