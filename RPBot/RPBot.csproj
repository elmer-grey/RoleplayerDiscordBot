<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <NoWarn Condition="'$(Configuration)' == 'Debug'">$(NoWarn);NU1900</NoWarn>
      <!-- 🩹 perf: Server GC + CONCURRENT (background) уменьшают паузы GC, которые
           иначе блокируют все потоки и приводят к "Приложение не отвечает" в Discord.
           Workstation GC по умолчанию блокирует ВСЕ потоки при Gen2 сборке;
           Server GC + concurrent даёт фоновую сборку без полной остановки мира. -->
      <ServerGarbageCollection>true</ServerGarbageCollection>
      <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Numbers\**" />
    <EmbeddedResource Remove="Numbers\**" />
    <None Remove="Numbers\**" />
  </ItemGroup>

  <!-- Lavalink: копируем application.yml в выходную папку при сборке.
       Lavalink.jar слишком большой для копирования — путь задаётся абсолютным в config.json.

       Condition="Exists(...)" — на чистом клоне файла нет (он в .gitignore,
       содержит OAuth refreshToken). Без Condition MSBuild падает с непонятным MSB3030.
       С Condition — файл просто пропускается.

       Target ниже выдаёт понятную инструкцию, если файла действительно нет. -->
  <ItemGroup>
    <Content Include="..\Lavalink\application.yml" Condition="Exists('..\Lavalink\application.yml')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Lavalink\application.yml</Link>
    </Content>
    <Content Include="Web\dashboard.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Web\dashboard.html</Link>
    </Content>
  </ItemGroup>

  <Target Name="CheckLavalinkApplicationYml" BeforeTargets="BeforeBuild" Condition="!Exists('..\Lavalink\application.yml')">
    <Error Text="Lavalink/application.yml не найден. Скопируй Lavalink/application.yml.example в Lavalink/application.yml (см. SETUP.md, шаг 5) и пересобери. Если ты сознательно не хочешь коммитить этот файл — проигнорируй это сообщение, бот соберётся без него (Lavalink запустится без YouTube OAuth)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.75.0.4178" />
    <PackageReference Include="Lavalink4NET" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.Discord.NET" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.InactivityTracking" Version="4.2.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Terminal.Gui" Version="1.19.0" />
  </ItemGroup>

</Project>